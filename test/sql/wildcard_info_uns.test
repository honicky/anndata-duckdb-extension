3

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM anndata_info('test/data/wildcard_uns_sample*.h5ad'));
----
_file_name	VARCHAR
property	VARCHAR
value	VARCHAR

# Every file contributes its full property set (9 rows each for these fixtures)
