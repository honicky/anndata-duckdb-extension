# =============================================================================

statement error
SELECT _file_name FROM anndata_scan_uns('test/data/wildcard_uns_sample1.h5ad') LIMIT 1;
----
_file_name

query III
SELECT key, type, value.scalar FROM anndata_scan_uns('test/data/wildcard_uns_sample1.h5ad') WHERE key = 'dataset_name';
----
dataset_name	scalar	Sample One

query I
SELECT COUNT(*) FROM anndata_scan_uns('test/data/wildcard_uns_sample1.h5ad');
----
6

# A single file without uns data keeps the legacy message row
query I
SELECT message FROM anndata_scan_uns('test/data/wildcard_sample1.h5ad');
----
No uns data in file

# =============================================================================
# Test 5: error handling
# =============================================================================

statement error
SELECT * FROM anndata_scan_uns('test/data/nonexistent_*.h5ad');
----
No files found

statement error
SELECT * FROM anndata_scan_uns('test/data/does_not_exist.h5ad');
----
not a valid AnnData file

# =============================================================================
# Test 6: anndata_info with wildcards
# =============================================================================

query I
