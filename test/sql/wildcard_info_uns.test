SELECT property, value FROM anndata_info('test/data/wildcard_uns_sample*.h5ad')
WHERE _file_name = 'wildcard_uns_sample3.h5ad' AND property IN ('groups', 'tables', 'x_shape', 'x_sparse') ORDER BY property;
