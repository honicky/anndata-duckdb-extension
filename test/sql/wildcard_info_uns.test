# =============================================================================
# Test 7: joining file-scoped results across functions by _file_name
# =============================================================================

# uns metadata joined with file info
query III
SELECT i._file_name, i.value AS n_obs, u.value.scalar AS n_cells
FROM anndata_info('test/data/wildcard_uns_sample*.h5ad') i
JOIN anndata_scan_uns('test/data/wildcard_uns_sample*.h5ad') u ON i._file_name = u._file_name
WHERE i.property = 'n_obs' AND u.key = 'n_cells'
ORDER BY i._file_name;
----
wildcard_uns_sample1.h5ad	5	5
wildcard_uns_sample2.h5ad	6	6
wildcard_uns_sample3.h5ad	7	7

# uns metadata joined with the obs table: n_cells matches the observation count of every file
query III
SELECT o._file_name, COUNT(*) AS cells, ANY_VALUE(CAST(u.value.scalar AS BIGINT)) AS n_cells
FROM anndata_scan_obs('test/data/wildcard_uns_sample*.h5ad') o
JOIN anndata_scan_uns('test/data/wildcard_uns_sample*.h5ad') u ON o._file_name = u._file_name AND u.key = 'n_cells'
GROUP BY o._file_name
HAVING COUNT(*) = ANY_VALUE(CAST(u.value.scalar AS BIGINT))
ORDER BY o._file_name;
----
wildcard_uns_sample1.h5ad	5	5
wildcard_uns_sample2.h5ad	6	6
wildcard_uns_sample3.h5ad	7	7
