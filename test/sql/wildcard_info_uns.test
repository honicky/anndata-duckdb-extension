groups	obs, var, X, uns
tables	obs, var, info, X, uns
x_shape	7 x 3
x_sparse	false

# Heterogeneous files: wildcard_sample*.h5ad carry obsm/varm/layers/obsp/varp and no uns data
query II
SELECT _file_name, value FROM anndata_info('test/data/wildcard_sample*.h5ad')
WHERE property = 'groups' ORDER BY _file_name;
----
wildcard_sample1.h5ad	obs, var, X, obsm, varm, layers, obsp, varp
wildcard_sample2.h5ad	obs, var, X, obsm, varm, layers, obsp, varp
wildcard_sample3.h5ad	obs, var, X, obsm, varm, layers, obsp, varp

# 15 properties per file for those fixtures
query I
SELECT COUNT(*) FROM anndata_info('test/data/wildcard_sample*.h5ad');
