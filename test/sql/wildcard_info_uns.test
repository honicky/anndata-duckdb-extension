wildcard_uns_sample2.h5ad	6
wildcard_uns_sample3.h5ad	7

# Aggregate across files
query I
SELECT SUM(CAST(value AS BIGINT)) FROM anndata_info('test/data/wildcard_uns_sample*.h5ad') WHERE property = 'n_obs';
